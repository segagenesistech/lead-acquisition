# Copy to .env and fill in. Only one discovery provider key is required.
PORT=4310

# Discovery — where candidate stores come from. "brave" | "serpapi" | "google" | "domains"
DISCOVERY_PROVIDER=brave
BRAVE_API_KEY=
SERPAPI_KEY=
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=

# Optional enrichments
PAGESPEED_API_KEY=        # Google PageSpeed Insights (mobile LCP). Works keyless at a low rate.
WPSCAN_API_TOKEN=         # Known plugin vulnerabilities. Without it, only "outdated" is reported.

# Limits
MONTHLY_AUDIT_QUOTA=500   # Full audits per calendar month
AUDITS_PER_SCAN=300       # "Full audit of top N by revenue risk"
SCAN_CONCURRENCY=8
CONTACT_EMAIL=            # Shown in the crawler User-Agent so site owners can reach you
